// Play My Playlist — database schema.
// Domain models are added per milestone with versioned migrations (never `prisma db push`).
// Target model: docs/architecture.md §3.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ────────────────────────────────────────────────────────────────

/// Anonymous guest identity. One per browser session family.
model User {
  id          String   @id @default(uuid()) @db.Uuid
  displayName String   @db.VarChar(24)
  avatarId    String   @db.VarChar(32)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    AuthSession[]
  roomPlayers RoomPlayer[]
}

/// Refresh-token session. Only SHA-256 hashes of tokens are stored.
model AuthSession {
  /// Generated by the application: it is embedded in the refresh token.
  id                String    @id @db.Uuid
  userId            String    @db.Uuid
  refreshTokenHash  String    @unique @db.Char(64)
  /// Previous token, accepted for a short grace window to absorb concurrent refreshes.
  previousTokenHash String?   @db.Char(64)
  rotatedAt         DateTime?
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Rooms ───────────────────────────────────────────────────────────────────

enum RoomStatus {
  LOBBY
  IN_GAME
  CLOSED
}

enum RoomVisibility {
  INVITE_ONLY
}

enum RoomPlayerStatus {
  ACTIVE
  LEFT
}

model Room {
  id             String         @id @default(uuid()) @db.Uuid
  code           String         @unique @db.Char(6)
  status         RoomStatus     @default(LOBBY)
  visibility     RoomVisibility @default(INVITE_ONLY)
  maxPlayers     Int            @db.SmallInt
  roundCount     Int            @db.SmallInt
  hostPlayerId   String?        @unique @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lastActivityAt DateTime       @default(now())

  hostPlayer RoomPlayer?  @relation("RoomHost", fields: [hostPlayerId], references: [id], onDelete: SetNull)
  players    RoomPlayer[] @relation("RoomPlayers")

  @@index([status, lastActivityAt])
}

/// A user's membership in one room. Leaving keeps the row (status LEFT) so rejoining reuses it.
model RoomPlayer {
  id          String           @id @default(uuid()) @db.Uuid
  roomId      String           @db.Uuid
  userId      String           @db.Uuid
  displayName String           @db.VarChar(24)
  avatarId    String           @db.VarChar(32)
  status      RoomPlayerStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  leftAt      DateTime?

  room       Room  @relation("RoomPlayers", fields: [roomId], references: [id], onDelete: Cascade)
  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostedRoom Room? @relation("RoomHost")

  @@unique([roomId, userId])
  @@index([roomId, status, joinedAt])
}
