# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=log

# docker compose (infrastructure/docker) exposes PostgreSQL on 5433 to avoid clashing with a local server.
DATABASE_URL=postgresql://pmp:pmp_dev_password@localhost:5433/play_my_playlist?schema=public
REDIS_URL=redis://localhost:6379

# Browser origin allowed by CORS (the Next.js frontend).
FRONTEND_ORIGIN=http://localhost:3000

# Auth. Generate the secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Number of reverse-proxy hops to trust for client IPs (0 when the API is exposed directly).
TRUST_PROXY_HOPS=0
